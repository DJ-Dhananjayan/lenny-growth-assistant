# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth_db

# Local LLM Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2

# Default Provider Selection (ollama, anthropic, openai)
DEFAULT_PROVIDER=ollama

# Cloud Providers (Optional for local demo)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Embedding Configuration
# Local lightweight embeddings: sentence-transformers/all-MiniLM-L6-v2 or ollama
EMBEDDING_PROVIDER=local
